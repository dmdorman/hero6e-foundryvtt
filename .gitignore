# IDE
.idea/
.vs/

# Share the editor setup. Keep personal VS Code state out of git.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Node Modules
node_modules/
npm-debug.log

# Foundry
*.lock

# Private stuff in the repo
private

# CSS files are generated from SCSS
css/

# FoundryVTT v11 creates several log files which we don't need in our system.
# However, we may need some of these when updating packs/compendiums.  Unclear if back-compat only.
# Don't commit LevelDB files for now for v10 back-compat
packs/**/*.log
packs/**/*.old
packs/**/*.ldb
packs/**/LOCK
packs/**/MANIFEST
packs/**/CURRENT
packs/**/LOG
packs/**/MANIFEST-*
.qodo


# Coding agents
.pi/

# Generated by `gulp lintTypes`. tsgolint reads its program config only from the repo root
# under this name, so the task writes it, runs, and deletes it again. Anchor the pattern to the
# root, or it also hides the tracked template under tools/typelint/.
/jsconfig.json
