<div class="hero auto-overflow">

    <section class="sheet-body">

        <div class="form-group">
            <label>ALIAS</label>
            <input type="text" name="mod.ALIAS" value="{{mod.ALIAS}}" />
        </div>

        {{#if (isdefined mod.LEVELS)}}
            {{#unless editOptions.hideLEVELS}}
            <div class="form-group">
                <label>LEVELS</label>
                <input type="text" name="mod.LEVELS" value="{{mod.LEVELS}}" />
            </div>
            {{/unless}}
        {{/if}}


        {{!-- Select for OPTIONID/OPTION/OPTION_ALIAS --}}
        {{#if editOptions.choices}}
            <div class="form-group">
                <label>OPTION</label>
                <select name="mod.OPTION">
                    {{selectOptions editOptions.choices selected=mod.OPTION valueAttr="OPTION" labelAttr="OPTION_ALIAS"}}
                </select>
            </div>

            <div class="form-group">
                <label>OPTIONID</label>
                <input disabled type="text" value="{{mod.OPTIONID}}" />
            </div>

            <div class="form-group">
                <label>OPTION_ALIAS</label>
                <input disabled type="text" value="{{mod.OPTION_ALIAS}}" />
            </div>
        {{else}}
            {{#if (isdefined mod.OPTIONID)}}
                <div class="form-group">
                    <label>OPTIONID</label>
                    <input type="text" name="mod.OPTIONID" value="{{mod.OPTIONID}}" />
                </div>
            {{/if}}

            {{#if (isdefined mod.OPTION)}}
                <div class="form-group">
                    <label>OPTION</label>
                    <input type="text" name="mod.OPTION" value="{{mod.OPTION}}" />
                </div>
            {{/if}}

            {{#if (isdefined mod.OPTION_ALIAS)}}
                <div class="form-group">
                    <label>OPTION_ALIAS</label>
                    <input type="text" name="mod.OPTION_ALIAS" value="{{mod.OPTION_ALIAS}}" />
                </div>
            {{/if}}

            {{#if (isdefined mod.ROLLALIAS)}}
                <div class="form-group">
                    <label>ROLLALIAS</label>
                    <input type="text" name="mod.ROLLALIAS" value="{{mod.ROLLALIAS}}" />
                </div>
            {{/if}}
        {{/if}}

        {{#if (isdefined mod.COMMENTS)}}
            <div class="form-group">
                <label>COMMENTS</label>
                <input type="text" name="mod.COMMENTS" value="{{mod.COMMENTS}}" />
            </div>
        {{/if}}

        <div class="form-group">
            <label>BASECOST</label>
            <input disabled type="text" value="{{mod.BASECOST}}" />
        </div>

        {{!-- ADDERS --}}
        {{#if mod.ADDER}}
            <hr />
            <table>
                <tr class="active-effects adders">
                    <th class="left">Adders</th>
                    <th>Cost</th>
                </tr>
                {{#each mod.ADDER as |adder|}}
                    <tr>
                        <td class="left">{{adder.ALIAS}}</td>
                        <td>{{adder.BASECOST}}</td>
                    </tr>
                {{/each}}
            </table>
        {{/if}}

    </section>

</div>
