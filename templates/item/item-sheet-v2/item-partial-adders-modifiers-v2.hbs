<table class="adders-modifiers">

    {{!-- ADDERS --}}
    <tr class="active-effects adders" >
        <th class="adder-name">Adders</th>
        <th class="adder-cost">Cost</th>
        <th class="adder-controls">
            {{#if @root/editable}}
                <a class="item-control modifier-create" title="Create"
                    data-action="create"
                    data-type="adder">
                    <i class="fas fa-plus"></i></a>
            {{/if}}
        </th>
    </tr>
    {{#each item.adders}}
        <tr data-adder-id="{{this.ID}}">
            <td class="adder-name">{{this.ALIAS}}</td>
            <td class="adder-cost">{{#if this.SELECTED}}{{this.BASECOST_total}}{{/if}}</td>
            <td class="adder-controls">
                {{> (getModulePath 'item/item-sheet-v2/item-sheet-actions-partial-v2.hbs') this }}
            </td>
        </tr>

        {{#each this.adders}}
            <tr class="modifier-adder indent">
                <td class="adder-name">{{this.ALIAS}}</td>
                <td class="adder-cost">{{this.BASECOST_total}}</td>
                <td class="adder-controls"></td>
            </tr>
        {{/each}}
    {{/each}}

    {{!-- {{Modifiers}} --}}
    <tr class="active-effects adders">
        <th class="modifier-name">Modifiers</th>
        <th class="adder-cost">Cost</th>
        <th class="modifier-controls">
            {{#if @root/editable}}
                <a class="item-control modifier-create" title="Create"
                    data-action="create"
                    data-type="modifier">
                    <i class="fas fa-plus"></i>
                </a>
            {{/if}}
        </th>
    </tr>
    {{#each item.modifiers as |mod|}}
        <tr class="{{#if mod.parentId}} from-parent{{/if}}{{#if (itemHeroValidationForModifier @root/item mod.ID)}} validation{{/if}}"
            data-modifier-id="{{mod.ID}}"
            {{#if (itemHeroValidationForModifier @root/item mod.ID)}}title="{{itemHeroValidationForModifier @root/item mod.ID}}"{{/if}}>
            <td class="modifier-name"
                title="{{#if (itemHeroValidationForModifier @root/item mod.ID)}}{{itemHeroValidationForModifier @root/item mod.ID}}{{else}}{{mod.XMLID}}{{/if}}">
                {{mod.ALIAS}} {{mod.OPTION_ALIAS}} {{#if mod.PRIVATE}}p{{/if}}</td>
            <td class="adder-cost">{{mod.cost}}</td>
            <td class="adder-controls">
                {{> (getModulePath 'item/item-sheet-v2/item-sheet-actions-partial-v2.hbs') this }}
            </td>
        </tr>

        {{#each mod.adders as |adder|}}
            <tr class="hero modifier-adder indent {{#if mod.parentId}}from-parent{{/if}}">
                <td class="adder-name" title="{{adder.XMLID}}">{{adder.ALIAS}} {{adder.OPTION_ALIAS}} {{#if adder.PRIVATE}}p{{/if}}</td>
                <td class="adder-cost">{{adder.cost}}</td>
                <td class="adder-controls"></td>
            </tr>
        {{/each}}

        {{#each mod.modifiers as |mod2|}}
            <tr class="hero modifier-adder indent {{#if mod.parentId}}from-parent{{/if}}">
                <td class="modifier-name" title="{{mod2.XMLID}}">{{mod2.ALIAS}} {{mod2.OPTION_ALIAS}} {{#if mod2.PRIVATE}}p{{/if}}</td>
                <td class="adder-cost">{{mod2.cost}}</td>
                <td class="adder-controls"></td>
            </tr>
        {{/each}}

    {{/each}}
    </table>
