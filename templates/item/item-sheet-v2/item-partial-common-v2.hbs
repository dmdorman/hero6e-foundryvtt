<div class="description">
    {{item.system.description}}
    {{#if item.system.NOTES}}
        <div class="item-notes-editable-content"><b>Notes:</b> {{{item.system.NOTES}}}</div>
    {{/if}}
</div>

{{#if (isdefined item.system.NAME)}}
    <div class="form-group">
        <label>NAME</label>
        <input type="text" name="system.NAME" value="{{item.system.NAME}}" />
    </div>
{{/if}}

{{#if (isdefined item.system.ALIAS)}}
    <div class="form-group">
        <label>ALIAS</label>
        <input type="text" name="system.ALIAS" value="{{item.system.ALIAS}}" />
    </div>
{{/if}}

{{#if (isdefined item.system.TEXT item "system.TEXT")}}
    <div class="form-group">
        <label>OVERRIDE TEXT</label>
        <input type="text" name="system.TEXT" value="{{item.system.TEXT}}" />
    </div>
{{/if}}

{{#if (isdefined item.system.PHASE)}}
    <div class="form-group">
        <label>PHASE</label>
        <input type="text" name="system.PHASE" value="{{item.system.PHASE}}" />
    </div>
{{/if}}

{{#if (isdefined item.system.OCV)}}
    <div class="form-group">
        <label>OCV</label>
        <input type="text" name="system.OCV" value="{{item.system.OCV}}" />
    </div>
{{/if}}

{{#if (isdefined item.system.DCV)}}
    <div class="form-group">
        <label>DCV</label>
        <input type="text" name="system.DCV" value="{{item.system.DCV}}" />
    </div>
{{/if}}
        
{{#if (isdefined item.system.DC)}}
    <div class="form-group">
        <label>DC</label>
        <input type="text" name="system.DC" value="{{item.system.DC}}" />
    </div>
{{/if}}

{{#if (isdefined item.system.EFFECT)}}
    <div class="form-group">
        <label>EFFECT</label>
        <input type="text" name="system.EFFECT" value="{{item.system.EFFECT}}" />
    </div>
{{/if}}

{{#if (isdefined item.system.WEAPONEFFECT)}}
    <div class="form-group">    
        <label>WEAPONEFFECT</label>
        <input type="text" name="system.WEAPONEFFECT" value="{{item.system.WEAPONEFFECT}}" />
    </div>
{{/if}}

{{#if (isdefined item.system.BASECOST)}}
    <div class="form-group">
        <label>BASECOST</label>
        <input type="text" name="system.BASECOST" value="{{item.system.BASECOST}}" />
    </div>
{{/if}}

{{#if (isdefined item.system.ACTIVECOST)}}
    <div class="form-group">
        <label>ACTIVECOST</label>
        <input type="text" name="system.ACTIVECOST" value="{{item.system.ACTIVECOST}}" />
    </div>
{{/if}}

{{!-- Martial Arts don't have LEVELS --}}
{{#if (isdefined item.system.LEVELS)}}
    {{#unless editOptions.hideLEVELS}}
        <div class="form-group">
            <label>LEVELS</label>
            <input {{#if (isdefined item.system.PDLEVELS item "system.PDLEVELS")}}disabled{{/if}}
            type="text" name="system.LEVELS" value="{{item.system.LEVELS}}" data-dtype="Number" 
            />
        </div>

        <div class="form-group">
            {{#if (isdefined item.system.QUANTITY)}}
                <label>QUANTITY</label>
                {{numberInput item.system.QUANTITY name="system.QUANTITY"}}
            {{/if}}
        </div>
    {{/unless}}
{{/if}}

{{#if (isdefined item.system.INPUT)}}
    <div class="form-group {{#if (itemHeroValidationForProperty item "INPUT")}}validation{{/if}}" 
        title="{{itemHeroValidationForProperty item "INPUT"}}"
        >
        <label>
            INPUT
            {{#if (itemHeroValidationForProperty item "INPUT")}}
                <i class="fa-regular fa-circle-exclamation"></i>
            {{/if}}
        </label>
        {{#if editOptions.choicesInput}}
            <select name="system.INPUT">
                {{selectOptions editOptions.choicesInput selected=item.system.INPUT valueAttr="INPUT" labelAttr="INPUT"}}
            </select>
        {{else}}
            <input type="text" name="system.INPUT" value="{{item.system.INPUT}}" />
        {{/if}}
    </div>
{{/if}}

{{#if (isdefined item.system.OPTION)}}
    {{#if editOptions.choices}}
        <div class="form-group">
            <label>OPTION</label>
            <select name="system.OPTION">
                {{selectOptions editOptions.choices selected=item.system.OPTION valueAttr="OPTION" labelAttr="OPTION_ALIAS"}}
            </select>
        </div>

        <div class="form-group">
            <label>OPTIONID</label>
            <input disabled type="text" value="{{item.system.OPTIONID}}" />
        </div>

        <div class="form-group {{#if (itemHeroValidationForProperty item "OPTION_ALIAS")}}validation{{/if}}" 
            title="{{itemHeroValidationForProperty item "OPTION_ALIAS"}}"
            >
            <label>
                OPTION_ALIAS
                {{#if (itemHeroValidationForProperty item "OPTION_ALIAS")}}
                    <i class="fa-regular fa-circle-exclamation"></i>
                {{/if}}
            </label>
            <input {{#unless editOptions.editableOption_ALIAS}}disabled{{/unless}} name="system.OPTION_ALIAS" type="text" value="{{item.system.OPTION_ALIAS}}" />
        </div>

    {{else}}
        <div class="form-group">
            <label>OPTION</label>
            <input type="text" name="system.OPTION" value="{{item.system.OPTION}}" />
        </div>

        {{#if (isdefined item.system.OPTIONID)}}
        <div class="form-group">
            <label>OPTIONID</label>
            <input type="text" name="system.OPTIONID" value="{{item.system.OPTIONID}}" />
        </div>
        {{/if}}

        {{#if (isdefined item.system.OPTION_ALIAS)}}
        <div class="form-group">
            <label>
                OPTION_ALIAS
            </label>
            <input type="text" name="system.OPTION_ALIAS" value="{{item.system.OPTION_ALIAS}}" />
        </div>
        {{/if}}

    {{/if}}
{{/if}}

{{! editOptions.showAttacks === true}}
{{#if attacks.length }}
    <div class="form-group {{#if (itemHeroValidationForProperty this.item "AttacksIncluded")}}validation{{/if}}"
        title="{{itemHeroValidationForProperty this.item "AttacksIncluded"}}">
        <label>
            Attacks Included:
            {{#if (itemHeroValidationForProperty this.item "AttacksIncluded")}}
                <i class="fa-regular fa-circle-exclamation"></i>
            {{/if}}
        </label>
        <div class="form-fields csl-attack-list">
            <ul>
                {{#each attacks }}
                    <li><input type="checkbox" name="attacks.{{this.id}}" {{checked this.checked}}/>
                    <span title="{{this.title}}">
                        {{this.name}}
                    </span>
                    </li>
                {{/each}}
            </ul>
        </div>
    </div>
{{/if}}

{{#if editOptions.penaltyChoices}}
    <div class="form-group">
        <label>PENALTY</label>
        <div class="form-fields">
            {{item.pslPenaltyType}}
        </div>
    </div>
{{/if}}

{{! COMBAT SKILL LEVELS}}
{{#if item.system.csl}}
 <div class="form-group">
    <label>SKILL LEVELS</label>
    <div class="form-fields">
        <ol>
            {{#each item.system.csl}}
            <li>
                {{!-- {{ radioBoxes this.name @root/cslChoices checked=this.value localize=true}} --}}
                {{!-- <input type="text" name="system.csl.{{@index}}" value="{{this}}"> --}}

                <select name="system.csl.{{@index}}">
                    {{selectOptions @root/item.cslChoices selected=this}}
                </select>
                
            </li>
            {{/each}}
        </ol>

    </div>
</div>
{{/if}}

{{#if (isdefined item.system.TYPE)}}
<div class="form-group">
    <label>TYPE</label>
    <input type="text" name="system.TYPE" value="{{system.TYPE}}" />
</div>
{{/if}}

{{!Martial Maneuver--}}
{{#if (isdefined item.system.USEWEAPON)}}
<div class="form-group">
    <label>USEWEAPON</label>
    <input type="checkbox" name="system.USEWEAPON" {{checked item.system.USEWEAPON}}/>
</div>
{{/if}}

{{!-- RANGE is also a StringField on powers; for martial arts it is a numeric range-modifier offset --}}
{{#if (and (eq item.type "martialart") (isdefined item.system.RANGE item "system.RANGE"))}}
<div class="form-group">
    <label>RANGE</label>
    <input type="text" name="system.RANGE" value="{{item.system.RANGE}}" data-dtype="Number" />
</div>
{{/if}}

{{!-- ADDSTR/MAXSTR only carry data on attack maneuvers; framework rows (LIST, Weapon Element) leave them null --}}
{{#if (and (isdefined item.system.ADDSTR item "system.ADDSTR") (notEqual item.system.ADDSTR null))}}
<div class="form-group">
    <label>ADDSTR</label>
    <input type="checkbox" name="system.ADDSTR" {{checked item.system.ADDSTR}}/>
</div>

<div class="form-group" title="Maximum STR that can add to this maneuver. Hero Designer exports 0 for most maneuvers; weapon-based ones (e.g. Killing Strike) carry a real cap.">
    <label>MAXSTR</label>
    <input type="text" name="system.MAXSTR" value="{{system.MAXSTR}}" data-dtype="Number" />
</div>
{{/if}}

{{!-- Hero Designer only sets DAMAGETYPE on custom maneuvers; standard maneuvers always export 0 (None) and derive damage from EFFECT --}}
{{#if item.system.DAMAGETYPE}}
    <div class="form-group" title="Hero Designer sets this only for custom maneuvers; standard maneuvers always export None and derive their damage from EFFECT.">
        <label>DAMAGETYPE</label>
        {{#if martialArtsDamageTypeChoices}}
            <select name="system.DAMAGETYPE" data-dtype="Number">
                {{selectOptions martialArtsDamageTypeChoices selected=item.system.DAMAGETYPE valueAttr="key" labelAttr="label"}}
            </select>
        {{else}}
            missing martialArtsDamageTypeChoices
        {{/if}}
    </div>
{{/if}}

{{!-- FORCEFIELD --}}
{{#if (isdefined item.system.PDLEVELS)}}
<div class="form-group">
    <label>PDLEVELS</label>
    <input type="text" name="system.PDLEVELS" value="{{item.system.PDLEVELS}}" data-dtype="Number" />
</div>
{{/if}}
{{#if (isdefined item.system.EDLEVELS)}}
<div class="form-group">
    <label>EDLEVELS</label>
    <input type="text" name="system.EDLEVELS" value="{{item.system.EDLEVELS}}" data-dtype="Number" />
</div>
{{/if}}
{{#if (isdefined item.system.MDLEVELS)}}
<div class="form-group">
    <label>MDLEVELS</label>
    <input type="text" name="system.MDLEVELS" value="{{item.system.MDLEVELS}}" data-dtype="Number" />
</div>
{{/if}}
{{#if (isdefined item.system.POWDLEVELS)}}
<div class="form-group">
    <label>POWDLEVELS</label>
    <input type="text" name="system.POWDLEVELS" value="{{item.system.POWDLEVELS}}" data-dtype="Number" />
</div>
{{/if}}

{{!-- FORCEWALL/Barrier --}}
{{#if (isdefined item.system.LENGTHLEVELS)}}
<div class="form-group">
    <label>LENGTHLEVELS</label>
    <input type="text" name="system.LENGTHLEVELS" value="{{item.system.LENGTHLEVELS}}" data-dtype="Number" />
</div>
{{/if}}
{{#if (isdefined item.system.HEIGHTLEVELS)}}
<div class="form-group">
    <label>HEIGHTLEVELS</label>
    <input type="text" name="system.HEIGHTLEVELS" value="{{item.system.HEIGHTLEVELS}}" data-dtype="Number" />
</div>
{{/if}}
{{#if (isdefined item.system.WIDTHLEVELS)}}
<div class="form-group">
    <label>WIDTHLEVELS</label>
    <input type="text" name="system.WIDTHLEVELS" value="{{item.system.WIDTHLEVELS}}" data-dtype="Number" />
</div>
{{/if}}
{{#if (isdefined item.system.BODYLEVELS)}}
<div class="form-group">
    <label>BODYLEVELS</label>
    <input type="text" name="system.BODYLEVELS" value="{{item.system.BODYLEVELS}}" data-dtype="Number" />
</div>
{{/if}}

{{#if (isdefined item.system.USESTANDARDEFFECT)}}
<div class="form-group">
    <label>USESTANDARDEFFECT</label>
    <input type="checkbox" name="system.USESTANDARDEFFECT" {{checked item.system.USESTANDARDEFFECT}}/>
</div>
{{/if}}

{{#if (isdefined item.system.AFFECTS_PRIMARY)}}
<div class="form-group">
    <label>AFFECTS_PRIMARY</label>
    <input type="checkbox" name="system.AFFECTS_PRIMARY" {{checked item.system.AFFECTS_PRIMARY}}/>
</div>
{{/if}}

{{#if (isdefined item.system.AFFECTS_TOTAL)}}
<div class="form-group">
    <label>AFFECTS_TOTAL</label>
    <input type="checkbox" name="system.AFFECTS_TOTAL" {{checked item.system.AFFECTS_TOTAL}}/>
</div>
{{/if}}

{{#if (isdefined item.system.USE_END_RESERVE)}}
<div class="form-group">
    <label>USE_END_RESERVE</label>
    <input type="checkbox" name="system.USE_END_RESERVE" {{checked item.system.USE_END_RESERVE}}/>
</div>
{{/if}}


{{#if (isdefined item.system.CHARACTERISTIC)}}
<div class="form-group">
    <label>CHARACTERISTIC</label>
    <select name="system.CHARACTERISTIC">
        {{selectOptions skillCharacteristicOptions selected=item.system.CHARACTERISTIC}}
    </select>
</div>
{{/if}}


{{!-- These flags exist on other schemas too but are only meaningful for skills --}}
{{#if (and (eq item.type "skill") (isdefined item.system.LEVELSONLY))}}
<div class="form-group">
    <label>LEVELSONLY</label>
    <input type="checkbox" name="system.LEVELSONLY" {{checked item.system.LEVELSONLY}}  
    {{#if (or (or item.system.FAMILIARITY item.system.EVERYMAN) item.system.PROFICIENCY)}}disabled{{/if}}/>
</div>
{{/if}}

{{#if (and (eq item.type "skill") (isdefined item.system.FAMILIARITY))}}
<div class="form-group">
    <label>FAMILIARITY</label>
    <input type="checkbox" name="system.FAMILIARITY" {{checked item.system.FAMILIARITY}} 
    {{#if (or item.system.LEVELSONLY item.system.PROFICIENCY)}}disabled{{/if}}/>
</div>
{{/if}}

{{!-- if FAMILIARITY is present then EVERYMAN can be an option --}}
{{#if (and (eq item.type "skill") (isdefined item.system.FAMILIARITY))}}
<div class="form-group">
    <label>EVERYMAN</label>
    <input type="checkbox" name="system.EVERYMAN" {{checked item.system.EVERYMAN}}  
    {{#if (or item.system.LEVELSONLY item.system.PROFICIENCY)}}disabled{{/if}}/>
</div>
{{/if}}

{{#if (and (eq item.type "skill") (isdefined item.system.PROFICIENCY))}}
<div class="form-group">
    <label>PROFICIENCY</label>
    <input type="checkbox" name="system.PROFICIENCY" {{checked item.system.PROFICIENCY}}  
    {{#if (or item.system.LEVELSONLY item.system.FAMILIARITY)}}disabled{{/if}}/>
</div>
{{/if}}

{{#if (and (eq item.type "skill") (isdefined item.system.NATIVE_TONGUE))}}
<div class="form-group">
    <label>NATIVE TONGUE</label>
    <input type="checkbox" name="system.NATIVE_TONGUE" {{checked item.system.NATIVE_TONGUE}} />
</div>
{{/if}}


{{#if (isdefined item.system.SFX)}}
<div class="form-group">
    <label>SFX</label>
    <input type="text" name="system.SFX" value="{{item.system.SFX}}" />
</div>
{{/if}}

{{#if item.system.chargeModifier}}
    <div class="form-group">
        <label>Charges</label>
        <div class="resource-fraction">
            <input type="text" name="system.numCharges" value="{{system.numCharges}}" data-dtype="Number" />
            <span class="resource-max" title="Maximum; edit with the CHARGES modifier">/ {{system.chargesMax}}</span>
        </div>
    </div>

    {{#if item.system.chargeModifier.CLIPS}}
        <div class="form-group">
            <label>Clips</label>
            <div class="resource-fraction">
                <input type="text" name="system.clips" value="{{system.clips}}" data-dtype="Number" />
                <span class="resource-max" title="Maximum; edit with the CLIPS adder">/ {{system.clipsMax}}</span>
            </div>
        </div>
    {{/if}}
{{/if}}

{{#with item}}
    {{#if this.isAblativeDefense}}
        <div class="form-group">
            <label>Ablative Threshold Exceeded</label>
            <input type="text" name="system.ablative" value="{{system.ablative}}" data-dtype="Number" />
        </div>
    {{/if}}
{{/with}}
