{{!-- HandlebarsApplicationMixin parts require a single root element --}}
<div class="item-sheet-content">

<header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage" title="{{item.name}}" />
    <div class="header-fields">
        <h1 class="item-name">{{item.name}}</h1>
        <div class="xmlid">{{item.system.XMLID}}</div>
    </div>
    {{#if system._hdcXml}}
        <a class="restore-from-hdc" data-action="restoreFromHdc"
            data-tooltip="Restore this item from its original Hero Designer data">
            <i class="fas fa-clock-rotate-left"></i>
        </a>
    {{/if}}
</header>

{{!-- Sheet Body --}}
<section class="sheet-body">

    {{#if isEnduranceReserve}}
        <div class="form-group">
            <label>ENDURANCE (current)</label>
            <input type="text" name="system.value" value="{{system.value}}" data-dtype="Number" />
        </div>

        <div class="form-group">
            <label>REC</label>
            <input type="text" name="rec" value="{{rec}}" data-dtype="Number" />
        </div>

        <hr />
    {{/if}}

    {{#if (eq item.type "equipment")}}
        <div class="form-group">
            <label>Carried</label>
            <input type="checkbox" name="system.CARRIED" {{checked system.CARRIED}} data-dtype="Boolean" />
        </div>

        <div class="form-group">
            <label>Active</label>
            <input type="checkbox" name="system.active" {{checked system.active}} data-dtype="Boolean" />
        </div>

        <div class="form-group">
            <label>Weight</label>
            <input type="text" name="system.WEIGHT" value="{{system.WEIGHT}}" data-dtype="Number" />
        </div>

        <div class="form-group">
            <label>Price</label>
            <input type="text" name="system.PRICE" value="{{system.PRICE}}" data-dtype="Number" />
        </div>
    {{/if}}

    {{!-- Common --}}
    {{> (getModulePath 'item/item-sheet-v2/item-partial-common-v2.hbs') }}

    {{!-- Adjustment Targets/Sources (possibly infinite number depending on modifiers and 5e vs 6e) --}}
    {{#each reduces as |input id|}}
        <div class="form-group">
            <label>{{@root/item.system.XMLID}} From {{increment id 1}}</label>
            <select name="reduces.{{id}}" data-dtype="text">
                {{selectOptions @root/possibleReduces selected=input}}
            </select>
        </div>
    {{/each}}

    {{#each enhances as |input id|}}
        <div class="form-group">
            <label>{{@root/item.system.XMLID}} To {{increment id 1}}</label>
            <select name="enhances.{{id}}" data-dtype="text">
                {{selectOptions @root/possibleEnhances selected=input}}
            </select>
        </div>
    {{/each}}

    {{!-- Active Points --}}
    {{> (getModulePath 'item/item-sheet-v2/item-partial-active-points-v2.hbs') }}

    {{!-- Adders & Modifiers --}}
    {{> (getModulePath 'item/item-sheet-v2/item-partial-adders-modifiers-v2.hbs') }}

</section>

</div>
