<aside>
    <div class="sidebar">
        {{#if (eq portraitToggleState "portrait")}}
        <img class="profile-img {{#if (getScopedFlagValue actor @root/gameSystemId "uploading")}}uploading-blur{{/if}}" 
            src="{{actor.img}}" 
            data-edit="img" 
            data-action="{{#if actor.isOwner}}updateActorImage{{/if}}"
            title="{{actor.name}}" height="100"
            width="100" 
        />
        {{/if}}
        {{#if (eq portraitToggleState "token")}}
        <img class="profile-img {{#if (getScopedFlagValue actor @root/gameSystemId "uploading")}}uploading-blur{{/if}}" 
            src="{{#if actor.isToken}}{{token.texture.src}}{{else}}{{actor.prototypeToken.texture.src}}{{/if}}" 
            data-edit="img" 
            data-action="{{#if actor.isOwner}}updateTokenImage{{/if}}"
            title="{{actor.name}}" height="100"
            width="100" 
        />
        {{/if}}
        <div class="sidebar-actions flexrow">
            <button class="profile-img-button {{#if (getScopedFlagValue actor @root/gameSystemId "uploading")}}uploading-blur{{/if}}" type="button" data-action="togglePortrait">
                {{#if (eq portraitToggleState "portrait")}} Portrait {{/if}}
                {{#if (eq portraitToggleState "token")}} Token {{/if}}
	    </button>
        </div>

        <section class="flexrow">
            <div class="attributes flexcol">
                {{#if (hasCharacteristic actor "END")}}
                    {{#with (getCharacteristic actor "END")}}
                        <fieldset class="attribute health {{#if (getScopedFlagValue actor @root/gameSystemId "uploading")}}uploading-blur{{/if}}" data-ability="end">
                            <legend class="attribute-name box-title">Endurance</legend>
                            <div class="attribute-value multiple characteristic">
                                <input name="Xsystem.characteristics.end.value" type="text"
                                    value="{{this.value}}" data-dtype="Number" step="1"
                                    class="{{#if (gt this.value this.max)}}over-max{{/if}}{{#if (lt this.value this.max)}} under-max{{/if}}">
                                <span class="sep"> / </span>
                                <span>
                                    ({{this.max}})
                                </span>
                            </div>
                        </fieldset>
                    {{/with}}
                {{/if}}

                {{#if endReserve}}
                    <fieldset class="attribute health {{#if (getScopedFlagValue actor @root/gameSystemId "uploading")}}uploading-blur{{/if}}" data-ability="endReserve" >
                        <legend title="{{endReserve.name}}">END Reserve</legend>
                        <div class="attribute-value multiple characteristic">
                            <input name="endReserve.{{endReserve.id}}.value" type="text"
                                value="{{endReserve.system.value}}" data-dtype="Number" step="1"
                                class="{{#if (gt endReserve.system.value endReserve.system.LEVELS)}}over-max{{/if}}
                                {{#if (lt endReserve.system.value endReserve.system.LEVELS)}} under-max{{/if}}">
                            <span class="sep"> / </span>
                            <span>
                                ({{endReserve.system.LEVELS}})
                            </span>
                        </div>
                    </fieldset>
                {{/if}}

                {{#if (hasCharacteristic actor "BODY")}}
                    {{#with (getCharacteristic actor "BODY")}}
                        <fieldset class="attribute health {{#if (getScopedFlagValue actor @root/gameSystemId "uploading")}}uploading-blur{{/if}}" data-ability="body">
                            <legend class="attribute-name box-title">Body</legend>
                            <div class="attribute-value multiple characteristic">
                                <input name="Xsystem.characteristics.body.value" type="text"
                                    value="{{this.value}}" data-dtype="Number" step="1"
                                    class="{{#if (gt this.value this.max)}}over-max{{/if}}{{#if (lt this.value this.max)}} under-max{{/if}}">
                                <span class="sep"> / </span>
                                <span>
                                    ({{this.max}})
                                </span>
                            </div>
                        </fieldset>
                    {{/with}}
                {{/if}}

                {{#if (hasCharacteristic actor "STUN")}}
                    {{#with (getCharacteristic actor "STUN")}}
                        <fieldset class="attribute health {{#if (getScopedFlagValue actor @root/gameSystemId "uploading")}}uploading-blur{{/if}}" data-ability="stun">
                            <legend class="attribute-name box-title">Stun</legend>
                            <div class="attribute-value multiple characteristic">
                                <input name="Xsystem.characteristics.stun.value" type="text"
                                    value="{{this.value}}" data-dtype="Number" step="1"
                                    class="{{#if (gt this.value this.max)}}over-max{{/if}}{{#if (lt this.value this.max)}} under-max{{/if}}">
                                <span class="sep"> / </span>
                                <span>
                                    ({{this.max}})
                                </span>
                            </div>
                        </fieldset>
                    {{/with}}
                {{/if}}

                {{#if useHAP }}
                    <fieldset class="attribute heroic-action-points {{#if (getScopedFlagValue actor @root/gameSystemId "uploading")}}uploading-blur{{/if}}" data-ability="hap">
                        <legend class="attribute-name box-title" title="Heroic Action Points">HAP</legend>
                        <div class="attribute-value multiple characteristic">
                            <input name="system.hap.value" type="text"
                                value="{{actor.system.hap.value}}" data-dtype="Number" step="1" min="0"
                                >
                        </div>
                    </fieldset>
                {{/if}}

                <fieldset class="defenses {{#if (getScopedFlagValue actor @root/gameSystemId "uploading")}}uploading-blur{{/if}}">
                    <legend class="box-title" data-tooltip="Defense Overview">Defenses</legend>
                    <li title="{{defense.PDtags}}"><span>PD={{defense.PD}}</span></li>
                    <li title="{{defense.rPDtags}}"><span>rPD={{defense.rPD}}</span></li>
                    <li title="{{defense.EDtags}}"><span>ED={{defense.ED}}</span></li>
                    <li title="{{defense.rEDtags}}"><span>rED={{defense.rED}}</span></li>

                    <li title="{{defense.MDtags}}"><span>MD={{defense.MD}}</span></li>
                    {{#if defense.rMD}}<li title="{{defense.rMDtags}}"><span>rMD={{defense.rMD}}</span></li>{{/if}}

                    {{#if defense.drp}}<li title="{{defense.drptags}}"><span>drp={{defense.drp}}%</span></li>{{/if}}
                    {{#if defense.dre}}<li title="{{defense.dretags}}"><span>dre={{defense.dre}}%</span></li>{{/if}}
                    {{#if defense.drm}}<li title="{{defense.drmtags}}"><span>drm={{defense.drm}}%</span></li>{{/if}}

                    {{#if defense.dnp}}<li title="{{defense.dnptags}}"><span>dnp={{defense.dnp}}</span></li>{{/if}}
                    {{#if defense.dne}}<li title="{{defense.dnetags}}"><span>dne={{defense.dne}}</span></li>{{/if}}
                    {{#if defense.dnm}}<li title="{{defense.dnmtags}}"><span>dnm={{defense.dnm}}</span></li>{{/if}}

                    <li title="{{defense.POWDtags}}"><span>POWD={{defense.POWD}}</span></li>
                    {{#if defense.rPOWD}}<li title="{{defense.rPOWDtags}}"><span>rPOWD={{defense.rPOWD}}</span></li>{{/if}}
                </fieldset>

                <div class="sidebar-actions flexrow">
                    <button class="{{#if (getScopedFlagValue actor @root/gameSystemId "uploading")}}uploading-blur{{/if}}" type="button" data-action="recovery">Take Recovery</button>
                    <button class="{{#if (getScopedFlagValue actor @root/gameSystemId "uploading")}}uploading-blur{{/if}}" type="button" data-action="presenceAttack">Presence Attack</button>
                    <button type="button" data-action="fullHealth"
                        title="Restore all characteristics to max, remove status effects, and remove temporary effects">Full
                        Health</button>
                    <button class="{{#if (getScopedFlagValue actor @root/gameSystemId "uploading")}}uploading-blur{{/if}}" type="button" data-action="actorDescription"
                        title="Show Actor Description and all perceivable powers">Actor Description</button>
                </div>
            </div>
        </section>
    </div>
</aside>
