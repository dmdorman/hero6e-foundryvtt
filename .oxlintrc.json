{
  // oxlint configuration
  //
  // Categories are switched off individually rather than using oxlint's defaults:
  // oxlint's default `correctness` category is broader than ESLint's `recommended`
  // set and would add ~500 findings (mostly chai assertion "unused expressions").
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // oxlint lints JavaScript only. stylelint owns SCSS.
  "ignorePatterns": ["node_modules/**", "css/**", "packs_old/**", "**/*.scss", "**/*.sass"],
  "env": {
    "browser": true,
    "jquery": true,
    "node": true,
    "es2022": true
  },
  "globals": {
    "ActiveEffect": "readonly",
    "canvas": "readonly",
    "ChatMessage": "readonly",
    "Combat": "readonly",
    "CONFIG": "readonly",
    "CONST": "readonly",
    "ForgeAPI": "readonly",
    "foundry": "readonly",
    "game": "readonly",
    "Handlebars": "readonly",
    "HeroSystem6eItem": "readonly",
    "Hooks": "readonly",
    "PIXI": "readonly",
    "quench": "readonly",
    "SimpleCalendar": "readonly",
    "ui": "readonly"
  },
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    // Parity with the former ESLint `js.configs.recommended` set.
    "eslint/constructor-super": "error",
    "eslint/for-direction": "error",
    "eslint/getter-return": ["error", { "allowImplicit": false }],
    "eslint/no-async-promise-executor": "error",
    "eslint/no-case-declarations": "error",
    "eslint/no-class-assign": "error",
    "eslint/no-compare-neg-zero": "error",
    "eslint/no-cond-assign": ["error", "except-parens"],
    "eslint/no-const-assign": "error",
    "eslint/no-constant-binary-expression": ["error", { "checkRelationalComparisons": false }],
    "eslint/no-constant-condition": ["error", { "checkLoops": "allExceptWhileTrue" }],
    "eslint/no-control-regex": "error",
    "eslint/no-debugger": "error",
    "eslint/no-delete-var": "error",
    "eslint/no-dupe-class-members": "error",
    "eslint/no-dupe-else-if": "error",
    "eslint/no-dupe-keys": "error",
    "eslint/no-duplicate-case": "error",
    "eslint/no-empty": ["error", { "allowEmptyCatch": false }],
    "eslint/no-empty-character-class": "error",
    "eslint/no-empty-pattern": ["error", { "allowObjectPatternsAsParameters": false }],
    "eslint/no-empty-static-block": "error",
    "eslint/no-ex-assign": "error",
    "eslint/no-fallthrough": ["error", { "allowEmptyCase": true, "reportUnusedFallthroughComment": false }],
    "eslint/no-func-assign": "error",
    "eslint/no-global-assign": ["error", { "exceptions": [] }],
    "eslint/no-import-assign": "error",
    "eslint/no-invalid-regexp": ["error", {}],
    "eslint/no-irregular-whitespace": [
      "error",
      {
        "skipComments": false,
        "skipJSXText": false,
        "skipRegExps": false,
        "skipStrings": true,
        "skipTemplates": false
      }
    ],
    "eslint/no-loss-of-precision": "error",
    "eslint/no-misleading-character-class": ["error", { "allowEscape": false }],
    "eslint/no-new-native-nonconstructor": "error",
    "eslint/no-nonoctal-decimal-escape": "error",
    "eslint/no-obj-calls": "error",
    "eslint/no-prototype-builtins": "error",
    "eslint/no-redeclare": ["error", { "builtinGlobals": true }],
    "eslint/no-regex-spaces": "error",
    "eslint/no-self-assign": ["error", { "props": true }],
    "eslint/no-setter-return": "error",
    "eslint/no-shadow-restricted-names": ["error", { "reportGlobalThis": true }],
    "eslint/no-sparse-arrays": "error",
    "eslint/no-this-before-super": "error",
    "eslint/no-unassigned-vars": "error",
    "eslint/no-undef": ["error", { "typeof": false }],
    "eslint/no-unreachable": "error",
    "eslint/no-unsafe-finally": "error",
    "eslint/no-unsafe-negation": ["error", { "enforceForOrderingRelations": false }],
    "eslint/no-unsafe-optional-chaining": ["error", { "disallowArithmeticOperators": false }],
    "eslint/no-unused-labels": "error",
    "eslint/no-unused-private-class-members": "error",
    "eslint/no-unused-vars": [
      "error",
      {
        "vars": "all",
        "args": "after-used",
        "ignoreRestSiblings": false,
        "caughtErrors": "all",
        "ignoreClassWithStaticInitBlock": false,
        "ignoreUsingDeclarations": false,
        "reportUsedIgnorePattern": false
      }
    ],
    "eslint/no-useless-assignment": "error",
    "eslint/no-useless-backreference": "error",
    "eslint/no-useless-catch": "error",
    "eslint/no-useless-escape": ["error", { "allowRegexCharacters": [] }],
    "eslint/no-with": "error",
    "eslint/preserve-caught-error": ["error", { "requireCatchParameter": false }],
    "eslint/require-yield": "error",
    "eslint/use-isnan": ["error", { "enforceForIndexOf": false, "enforceForSwitchCase": true }],
    "eslint/valid-typeof": ["error", { "requireStringLiterals": false }],

    // Beyond the former recommended set.
    "eslint/no-extra-boolean-cast": ["error", { "enforceForInnerExpressions": true }],
    // `functions: false` allows a call to a function declared lower in the file. Function
    // declarations hoist, so the call works, and this repo lists helpers below their callers.
    // ESLint's default is `true`. Measured with oxlint 1.87: `true` reports 353 findings in 29
    // files under `module/`. `variables` and `classes` stay on. Those cover the cases that throw
    // at run time, where a `const` or `class` is read above its declaration.
    "eslint/no-use-before-define": [
      "error",
      {
        "classes": true,
        "functions": false,
        "variables": true,
        "allowNamedExports": true,
        "enums": true,
        "typedefs": true,
        "ignoreTypeReferences": true
      }
    ],

    // Rules the old ESLint config never carried. Each one is clean across `module/` today, so
    // keeping them on costs nothing. `no-dupe-args` and `no-octal` need no entry: the parser
    // reports both regardless of configuration.
    "eslint/no-constructor-return": "error",
    "eslint/no-new-native-nonconstructor": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-unexpected-multiline": "error",
    "eslint/no-unused-private-class-members": "error",

    // Additional coverage only oxlint provides. These have no ESLint equivalent.
    "oxc/missing-throw": "error",
    "oxc/const-comparisons": "error",
    "oxc/erasing-op": "error",
    "oxc/no-accumulating-spread": "error",
    "oxc/no-this-in-exported-function": "error",
    "unicorn/no-empty-file": "error",
    "unicorn/no-new-array": "error",
    "unicorn/no-useless-spread": "error",
    "unicorn/prefer-set-size": "error"
  },
  "overrides": [
    {
      // Test suites deliberately use erasing arithmetic such as `expect(x).to.equal(3 * 0)`
      // and `return 0 / 4` as mock values, so the rule is silenced there.
      "files": ["module/testing/**"],
      "rules": {
        "oxc/erasing-op": "off"
      }
    }
  ]
}
